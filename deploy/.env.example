# Copy the required values into your VPS/Render secret settings.
# Do not commit a real .env file or paste credentials into chat.
SUN2AGENT_PROVIDER=nvidia
SUN2AGENT_MODEL=nvidia/model-name
SUN2AGENT_API_KEY=replace-me

SUN2AGENT_TELEGRAM_BOT_TOKEN=replace-me
SUN2AGENT_TELEGRAM_CHAT_ID=123456789

# Persistent writable directory; mount/retain this path on the host.
SUN2AGENT_DATA_DIR=/var/lib/sun2agent

# Optional integrations
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
# Required before creating Telegram schedules. Use an IANA name, e.g. Asia/Kolkata.
SUN2AGENT_TIMEZONE=

# Optional custom AGENT.md path (defaults to $SUN2AGENT_DATA_DIR/AGENT.md).
# SUN2AGENT_AGENT_MD=/var/lib/sun2agent/AGENT.md
